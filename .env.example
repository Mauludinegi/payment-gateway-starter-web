# URL of the Spring Boot API, as seen from the Nuxt server (not the browser).
NUXT_API_BASE=http://localhost:8080

# Google sign-in: Firebase console > Project settings > Your apps > Web app config.
# Also set FIREBASE_PROJECT_ID on the backend to the same project.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
